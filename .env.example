# ============================================================================================
# BetterSnap AI — COMPLETE environment variable reference
# ============================================================================================
# Config lives in THREE places. Each var below is tagged with where it belongs:
#   [FUNC]  Azure Function App settings   (the API / orchestration — Bettersnap-aI_Backend)
#   [GPU]   ACA job `bettersnapai-if` env (the GPU train+infer container — main.py / trainer)
#   [KV]    Azure Key Vault secret        (value lives in the vault, NOT in this file)
#
# Legend:  🔴 REQUIRED (system fails / is insecure without it)   ·   ⚡ affects GENERATION SPEED
#          💰 cost / capacity control   ·   (default) shown = the code's built-in fallback
#
# SECRETS (passwords, API keys) must NEVER be committed. In production they live in Key Vault;
# for LOCAL dev only, you may fill the KV-backed values below. Do NOT commit a filled copy.
# --------------------------------------------------------------------------------------------


# ── 1. REQUIRED — identity / auth [FUNC] ────────────────────────────────────────────────────
# 🔴 Without all three, token validation fails CLOSED and every authenticated call 401s.
ENTRA_AUD="d14bccac-4a37-4919-89a3-24272a0825bc"
ENTRA_ISSUER="https://74e900cf-7b3a-4593-8207-deec6656d91d.ciamlogin.com/74e900cf-7b3a-4593-8207-deec6656d91d/v2.0"
ENTRA_JWKS_URI="https://bettersnap.ciamlogin.com/74e900cf-7b3a-4593-8207-deec6656d91d/discovery/v2.0/keys"

# 🔴 Azure-managed (set automatically by the Function App). Listed for completeness.
# AzureWebJobsStorage="<functions runtime storage connection string>"
# APPLICATIONINSIGHTS_CONNECTION_STRING="<app insights connection string>"

# 🔴 Guards the /ops/* admin endpoints (requeue, fail, stuck-dispatch). If UNSET, those
# endpoints are DISABLED (fail-closed). Set a long random value to use ops tooling. [FUNC]
ADMIN_API_KEY=""


# ── 2. KEY VAULT SECRETS (referenced by name — values live in the vault) [KV] ────────────────
# 🔴 The code reads these via get_secret(<name>). Create/rotate them in Key Vault, not here.
#   Db-Password                      — Azure SQL password
#   storage-account-key              — blob SAS signing (result URLs)
#   storage-connection-string        — blob + queue access
#   stripe-secret-key                — Stripe API
#   stripe-webhook-secret            — Stripe webhook signature verification
#   stripe-price-onetime-basic|pro|expert     — Stripe Price ids (one-time packs)
#   stripe-price-monthly-basic|pro|expert     — Stripe Price ids (monthly plans)
#   acs-connection-string            — Azure Communication Services (email), if used
#   hftoken                          — HuggingFace token, if gated model access is needed
# NOTE: `supabase-jwt-secret` in the vault is DEAD (auth moved to Entra) — safe to delete.


# ── 3. REQUIRED — GPU job storage + callback [GPU] ──────────────────────────────────────────
# 🔴 Storage account NAME must match your real account. AZURE_STORAGE_KEY has NO default and
# is used to sign result SAS URLs (main.py) — confirm it is set on the ACA job.
AZURE_STORAGE_ACCOUNT="bettersnapaistorage"   # (default) — MUST match your real storage account
AZURE_STORAGE_KEY=""                           # 🔴 no default — signs result SAS URLs
STORAGE_CONNECTION_STRING=""                   # 🔴 blob + queue access from the GPU container
# 🔴 The frontend host the GPU job builds links to. DEFAULT IS LIKELY WRONG for you — set it
# to your real frontend (e.g. https://bettersnapai.cdfsandbox3.org).
APP_BASE_URL="https://bettersnap.ai"           # (default) — override to your real host
# Containers (defaults are the live names).
AZURE_BLOB_CONTAINER="outputs"                 # (default)
AZURE_LORA_CONTAINER="lora-weights"            # (default)
LORA_CONTAINER="lora-weights"                  # (default)
INPUT_CONTAINER="inputs"                       # (default)
AZURE_QUEUE_NAME="inference-jobs"              # (default)
# SQL (the GPU job + trainer read these; password comes from Key Vault / connection).
SQL_SERVER="bettersnap-srv.database.windows.net"   # (default)
SQL_DATABASE="bettersnap-db"                        # (default)


# ── 4. ⚡ AI GENERATION — quality & SPEED knobs [GPU] ─────────────────────────────────────────
# These directly control how LONG each image takes. Lower/skip = faster (test quality first).
NUM_INFERENCE_STEPS="30"      # ⚡ DOMINANT cost. 30 default. Lower (20–25) = faster; with an
                              #    LCM/Lightning distilled LoRA you can drop to 4–8 (3–4× faster).
GUIDANCE_SCALE="6.0"          # CFG scale. Not a speed knob; affects look.
UPSCALE_TARGET="2048"         # ⚡ 2K upscale. Set 0 to DISABLE the upscale pass entirely (ship 1024) = faster.
UPSCALE_HALF="0"              # ⚡ 0 = fp32 upscaler. Set 1 for fp16 = ~2× faster upscale (free, ample VRAM).
REALISM_PASS="1"             # ⚡ Full-frame realism img2img. Set 0 to SKIP a whole diffusion pass = faster.
REALISM_STRENGTH="0.18"       # ⚡ lower = fewer effective steps on that pass = slightly faster.
FACE_REFINE="1"              # ⚡ Face-refine img2img. Set 0 to SKIP a whole pass = faster.
FACE_REFINE_STRENGTH="0.45"   # ⚡ lower = fewer effective steps = slightly faster.
IP_ADAPTER_SCALE="0.6"        # Identity strength from the reference face (0 disables IP-Adapter).
GRAIN_AMOUNT="5.0"            # Film grain added at the end (cheap; look only).
NEGATIVE_PROMPT=""            # (default from code) — override to steer the model away from artifacts.
NUM_OUTPUTS="6"              # ⚡ Images per job when not plan-driven. Fewer = faster job.
GEN_WIDTH="1024"             # ⚡ Base resolution. 1024 is SDXL-native; higher = much slower.
GEN_HEIGHT="1024"            # ⚡ (see above)
# Models (baked into the image at /models — override only to point elsewhere).
BASE_MODEL="/models/sdxl-base"   # (default)
VAE_MODEL="/models/sdxl-vae"     # (default)
MODEL_VARIANT="fp16"             # ⚡ keep fp16 (fp32 would be far slower).
IMAGE_COUNT_OVERRIDE="0"         # test-only cap on images per job (0 = off).


# ── 5. TRAINING knobs (per-user identity LoRA) [GPU] ────────────────────────────────────────
MAX_TRAIN_STEPS="1400"           # ⚡ training length. Lower = faster training, less fidelity.
RANK="32"                        # LoRA rank. Higher = more capacity, slightly slower/larger.
LEARNING_RATE="1e-4"             # UNet LR.
TEXT_ENCODER_LR="5e-5"           # text-encoder LR.
PRIOR_LOSS_WEIGHT="1.0"          # DreamBooth prior-preservation weight.
NUM_CLASS_IMAGES="200"           # ⚡ class images generated for prior preservation; fewer = faster warmup.
GRADIENT_CHECKPOINTING="1"       # ⚡ 1 = saves VRAM but slower; 0 = faster if memory allows.
LORA_IDENTITY_WEIGHT="1.0"       # identity LoRA blend at inference.
INSTANCE_PROMPT="a photo of ohwx woman"   # (default) — trainer sets this per-run.
CLASS_PROMPT="a photo of a woman"          # (default) — trainer sets this per-run.
CLASS_WORD="woman"                          # (default) — trainer sets this per-run.
# IDENTITY_TRIGGER — defaults from shared/catalog.py; leave unset unless overriding.
MIN_TRAINING_PHOTOS="8"          # [FUNC] minimum photos accepted for training.
MAX_TRAINING_PHOTOS="12"         # [FUNC] maximum photos used for training.


# ── 6. 💰 COST & CAPACITY controls [FUNC] ────────────────────────────────────────────────────
GPU_DISPATCH_ENABLED="true"      # 💰 KILL SWITCH. Set "false" to halt ALL A100 spend instantly (no redeploy).
MAX_ACTIVE_GPU_JOBS="1"          # 💰 concurrent GPU jobs. Raise for throughput = more GPU cost.
PER_USER_DAILY_CAP="5"           # 💰 max jobs per user per day.
GLOBAL_DAILY_CAP="25"            # 💰 max jobs across all users per day.
GPU_BACKPRESSURE_BASE="30"       # over-cap backoff base (seconds).
GPU_BACKPRESSURE_MAX="600"       # over-cap backoff ceiling (seconds).
MAX_DISPATCH_DEFERS="20"         # after this many defers a job is failed (anti-churn).
KILL_SWITCH_PAUSE_DELAY="900"    # requeue delay while the kill switch is on (seconds).
GPU_LEASE_TTL_SECONDS="180"      # dispatch lease time-to-live.
GPU_DISPATCH_GRACE_SECONDS="60"  # grace before a pending dispatch is retried.
REAPER_STUCK_MINUTES="45"        # auto-fail a job stuck in 'processing' past this.
REAPER_DISPATCHING_MINUTES="15"  # auto-fail a job stuck in 'dispatching' past this.
TRAINING_STUCK_MINUTES="90"      # auto-fail a training run past this.
RETENTION_DAYS="3"               # days after which a user's BLOBS are deleted (DB rows kept).


# ── 7. INFRA config — optional, all have code fallbacks [FUNC] ──────────────────────────────
# Set these ONLY to move environments; unset = the live defaults above/in code.
AZURE_KEYVAULT_URL="https://bettersnapkeyvault.vault.azure.net/"   # (default)
KEYVAULT_CACHE_TTL_SECONDS="600"     # in-process secret cache TTL.
SQL_UID="CloudSAe874642e"            # (default) SQL user.
SQL_PASSWORD_SECRET="Db-Password"    # (default) Key Vault secret name holding the SQL password.
SQL_CONN_TIMEOUT="60"                # (default) SQL connection timeout (seconds).


# ── 8. PER-RUN — DO NOT SET (injected by the dispatcher at job start) ───────────────────────
# The queue/training dispatchers set these on each execution; setting them here does nothing
# useful and MODE especially must never be baked in:
#   MODE (train|infer) · JOB_ID · USER_ID · FILES_JSON · TRAIN_RUNDIR
