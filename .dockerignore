*
!Dockerfile
!Dockerfile.unified
!Dockerfile.app
!entrypoint.py
!gpu_preflight.py
!main.py
!requirements.txt
!rrdbnet.py
!stage_runtime.py
!prompt_control.py
# Phase 2 packages (domain contracts + runtime engines). Nested-whitelist walk like below.
!domain
domain/*
!domain/*.py
!runtime
runtime/*
!runtime/*.py
!runtime/engines
runtime/engines/*
!runtime/engines/*.py
# Trainer scripts, for the unified image's COPY training/trainer/... (same nested-whitelist
# walk as catalog.py below).
!training
training/*
!training/trainer
training/trainer/*
!training/trainer/run_training.py
!training/trainer/train_dreambooth_lora_sdxl.py
!training/trainer/train_text_to_image_lora_sdxl.py
# Whitelisting a DEEPLY NESTED file requires walking the directory chain: un-ignore
# each parent dir, re-ignore its contents, then un-ignore the specific file. Without
# this, `*` excludes Bettersnap-aI_Backend and the Dockerfile's
# `COPY Bettersnap-aI_Backend/shared/catalog.py` fails ("file not found in context").
!Bettersnap-aI_Backend
Bettersnap-aI_Backend/*
!Bettersnap-aI_Backend/shared
Bettersnap-aI_Backend/shared/*
!Bettersnap-aI_Backend/shared/catalog.py
!Bettersnap-aI_Backend/shared/catalog_data.py
